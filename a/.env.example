# انسخ هذا الملف إلى .env.local ثم عدّل القيم (لا ترفع .env.local إلى GitHub).

# AI Studio يحقن هذه القيم تلقائياً وقت التشغيل.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# قاعدة البيانات المشتركة بين المتجر ولوحة التحكم (Supabase PostgreSQL).
# يُفضّل رابط الـ pooler مع pgbouncer=true في الإنتاج.
SUPABASE_DB_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
# أو استخدم DATABASE_URL / SQL_HOST + SQL_USER + SQL_PASSWORD + SQL_DB_NAME.

# إلزامي في الإنتاج: سلسلة عشوائية طويلة لتوقيع جلسات الدخول.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# اختياري: بريدات إضافية تحصل على صلاحية أدمن (يفصل بينها بفاصلة).
ADMIN_EMAILS="admin@alhamd.local,amn2asayed@gmail.com,admin@alhamd.store"

# منفذ الخادم (افتراضي 3000). لا تضبط NODE_ENV يدوياً عند استخدام npm start.
PORT="3000"
